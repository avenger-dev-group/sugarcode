{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InitializeParams",
  "type": "object",
  "properties": {
    "capabilities": {
      "anyOf": [
        {
          "$ref": "#/$defs/InitializeCapabilities"
        },
        {
          "type": "null"
        }
      ]
    },
    "clientInfo": {
      "$ref": "#/$defs/ClientInfo"
    },
    "protocolVersion": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "protocolVersion",
    "clientInfo"
  ],
  "$defs": {
    "ClientInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "InitializeCapabilities": {
      "type": "object"
    }
  }
}
