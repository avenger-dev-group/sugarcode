{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnSnapshot",
  "type": "object",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnError"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "status": {
      "$ref": "#/$defs/TurnSnapshotStatus"
    }
  },
  "required": [
    "id",
    "status",
    "items"
  ],
  "$defs": {
    "Item": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "userMessage"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "agentMessage"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ]
        }
      ]
    },
    "TurnError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TurnErrorKind"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "retryable"
      ]
    },
    "TurnErrorKind": {
      "type": "string",
      "enum": [
        "authentication",
        "invalidRequest",
        "rateLimited",
        "timeout",
        "transport",
        "server",
        "protocol",
        "incomplete",
        "filtered",
        "unsupportedOutput",
        "outputTooLarge",
        "stateUnavailable"
      ]
    },
    "TurnSnapshotStatus": {
      "type": "string",
      "enum": [
        "inProgress",
        "completed",
        "failed",
        "interrupted"
      ]
    }
  }
}
