{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnSnapshot",
  "type": "object",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnError"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    },
    "status": {
      "$ref": "#/$defs/TurnSnapshotStatus"
    }
  },
  "required": [
    "id",
    "status",
    "items"
  ],
  "$defs": {
    "Item": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "userMessage"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "agentMessage"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "arguments": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "callId": {
              "type": "string"
            },
            "command": {
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "query": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "toolCall"
            }
          },
          "required": [
            "type",
            "id",
            "callId",
            "name",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "approvalId": {
              "type": "string"
            },
            "arguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "callId": {
              "type": "string"
            },
            "command": {
              "type": "string"
            },
            "cwd": {
              "type": "string"
            },
            "environmentPolicy": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "sandboxed": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "commandApprovalRequest"
            }
          },
          "required": [
            "type",
            "id",
            "approvalId",
            "callId",
            "command",
            "arguments",
            "cwd",
            "environmentPolicy",
            "sandboxed"
          ]
        },
        {
          "type": "object",
          "properties": {
            "approvalId": {
              "type": "string"
            },
            "decision": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "commandApprovalDecision"
            }
          },
          "required": [
            "type",
            "id",
            "approvalId",
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "callId": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "result": {
              "$ref": "#/$defs/ToolResult"
            },
            "type": {
              "type": "string",
              "const": "toolResult"
            }
          },
          "required": [
            "type",
            "id",
            "callId",
            "name",
            "result"
          ]
        }
      ]
    },
    "ProcessOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "format": "int64"
            },
            "type": {
              "type": "string",
              "const": "exitCode"
            }
          },
          "required": [
            "type",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "signal": {
              "type": "integer",
              "format": "int32"
            },
            "type": {
              "type": "string",
              "const": "signal"
            }
          },
          "required": [
            "type",
            "signal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "timedOut"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "ToolResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "content": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "success"
            }
          },
          "required": [
            "type",
            "content",
            "bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "type",
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "durationMs": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "encoding": {
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/ProcessOutcome"
            },
            "stderr": {
              "type": "string"
            },
            "stderrBytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "stderrTruncated": {
              "type": "boolean"
            },
            "stdout": {
              "type": "string"
            },
            "stdoutBytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "stdoutTruncated": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "process"
            }
          },
          "required": [
            "type",
            "stdout",
            "stderr",
            "stdoutBytes",
            "stderrBytes",
            "stdoutTruncated",
            "stderrTruncated",
            "encoding",
            "durationMs",
            "outcome"
          ]
        }
      ]
    },
    "TurnError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TurnErrorKind"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "retryable"
      ]
    },
    "TurnErrorKind": {
      "type": "string",
      "enum": [
        "authentication",
        "invalidRequest",
        "rateLimited",
        "timeout",
        "transport",
        "disconnected",
        "server",
        "protocol",
        "incomplete",
        "filtered",
        "unsupportedOutput",
        "outputTooLarge",
        "stateUnavailable"
      ]
    },
    "TurnSnapshotStatus": {
      "type": "string",
      "enum": [
        "inProgress",
        "completed",
        "failed",
        "interrupted"
      ]
    }
  }
}
