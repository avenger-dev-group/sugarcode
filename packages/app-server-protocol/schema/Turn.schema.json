{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turn",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TurnStatus"
    }
  },
  "required": [
    "id",
    "status"
  ],
  "$defs": {
    "TurnStatus": {
      "type": "string",
      "enum": [
        "inProgress",
        "completed"
      ]
    }
  }
}
