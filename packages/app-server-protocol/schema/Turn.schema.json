{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turn",
  "type": "object",
  "properties": {
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/TurnError"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelSelectionSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "$ref": "#/$defs/TurnStatus"
    }
  },
  "required": [
    "id",
    "status"
  ],
  "$defs": {
    "ModelProviderKind": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "gemini",
        "metallm",
        "openaiCompatible"
      ]
    },
    "ModelSelectionSnapshot": {
      "type": "object",
      "properties": {
        "contextWindowTokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "displayName": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "providerKind": {
          "$ref": "#/$defs/ModelProviderKind"
        }
      },
      "required": [
        "profileId",
        "providerKind",
        "modelId",
        "displayName",
        "contextWindowTokens"
      ]
    },
    "TurnError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TurnErrorKind"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "retryable"
      ]
    },
    "TurnErrorKind": {
      "type": "string",
      "enum": [
        "authentication",
        "invalidRequest",
        "rateLimited",
        "timeout",
        "transport",
        "disconnected",
        "server",
        "protocol",
        "incomplete",
        "filtered",
        "unsupportedOutput",
        "unsupportedToolArguments",
        "outputTooLarge",
        "stateUnavailable"
      ]
    },
    "TurnStatus": {
      "type": "string",
      "enum": [
        "inProgress",
        "completed",
        "failed",
        "interrupted"
      ]
    }
  }
}
