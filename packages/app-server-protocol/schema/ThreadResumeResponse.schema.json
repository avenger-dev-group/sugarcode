{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadResumeResponse",
  "type": "object",
  "properties": {
    "thread": {
      "$ref": "#/$defs/Thread"
    },
    "turns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TurnSnapshot"
      }
    }
  },
  "required": [
    "thread",
    "turns"
  ],
  "$defs": {
    "Item": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "userMessage"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "agentMessage"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ]
        }
      ]
    },
    "Thread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "TurnError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TurnErrorKind"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "retryable"
      ]
    },
    "TurnErrorKind": {
      "type": "string",
      "enum": [
        "authentication",
        "invalidRequest",
        "rateLimited",
        "timeout",
        "transport",
        "server",
        "protocol",
        "incomplete",
        "filtered",
        "unsupportedOutput",
        "outputTooLarge",
        "stateUnavailable"
      ]
    },
    "TurnSnapshot": {
      "type": "object",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Item"
          }
        },
        "status": {
          "$ref": "#/$defs/TurnSnapshotStatus"
        }
      },
      "required": [
        "id",
        "status",
        "items"
      ]
    },
    "TurnSnapshotStatus": {
      "type": "string",
      "enum": [
        "inProgress",
        "completed",
        "failed",
        "interrupted"
      ]
    }
  }
}
