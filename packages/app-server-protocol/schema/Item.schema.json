  "$defs": {
    "CommandNetworkPolicy": {
      "type": "string",
      "enum": [
        "networkDeniedV1"
      ]
    },
    "CommandSandboxPolicy": {
      "type": "string",
      "enum": [
        "filesystemReadOnlyV1"
      ]
    },
    "CommandWorkspaceWritePolicy": {
      "type": "string",
      "enum": [
        "commandWorkspaceWriteV1"
      ]
    },
    "CommandWorkspaceWriteRisk": {
      "type": "string",
      "enum": [
        "nonTransactionalWorkspaceTreeV1"
      ]
    },
    "FileChangeKind": {
      "type": "string",
      "enum": [
        "update"
      ]
    },
    "FileChangeNewlineStyle": {
      "type": "string",
      "enum": [
        "lf",
        "crLf"
      ]
    },
    "McpToolResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "canonical_bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "content": {
              "type": "string"
            },
            "content_blocks": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "is_error": {
              "type": "boolean"
            },
            "observed_bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "retained_bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "sha256": {
              "type": "string"
            },
            "structured_content": {
              "type": "boolean"
            },
            "truncated": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "completed"
            }
          },
          "required": [
            "type",
            "content",
            "is_error",
            "observed_bytes",
            "canonical_bytes",
            "retained_bytes",
            "truncated",
            "sha256",
            "content_blocks",
            "structured_content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "request_state": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "type",
            "kind",
            "request_state"
          ]
        }
      ]
    },
    "ProcessOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "format": "int64"
            },
            "type": {
              "type": "string",
              "const": "exitCode"
            }
          },
          "required": [
            "type",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "signal": {
              "type": "integer",
              "format": "int32"
            },
            "type": {
              "type": "string",
              "const": "signal"
            }
          },
          "required": [
            "type",
            "signal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "timedOut"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "ToolResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "content": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "success"
            }
          },
          "required": [
            "type",
            "content",
            "bytes"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "required": [
            "type",
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "durationMs": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "encoding": {
              "type": "string"
            },
            "networkPolicy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CommandNetworkPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "outcome": {
              "$ref": "#/$defs/ProcessOutcome"
            },
            "sandboxPolicy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CommandSandboxPolicy"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stderr": {
              "type": "string"
            },
            "stderrBytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "stderrTruncated": {
              "type": "boolean"
            },
            "stdout": {
              "type": "string"
            },
            "stdoutBytes": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "stdoutTruncated": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "process"
            },
            "workspaceWritePolicy": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CommandWorkspaceWritePolicy"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "stdout",
            "stderr",
            "stdoutBytes",
            "stderrBytes",
            "stdoutTruncated",
            "stderrTruncated",
            "encoding",
            "durationMs",
            "outcome"
          ]
        }
      ]
    }
  }
}
