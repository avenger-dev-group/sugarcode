    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "agentMessage"
        }
      },
      "required": [
        "type",
        "id",
        "text"
      ]
    }
  ]
}
