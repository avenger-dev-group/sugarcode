        "type": {
          "type": "string",
          "const": "userMessage"
        }
      },
      "required": [
        "type",
        "id",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "agentMessage"
        }
      },
      "required": [
        "type",
        "id",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "arguments": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "callId": {
          "type": "string"
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "query": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string",
          "const": "toolCall"
        }
      },
      "required": [
        "type",
        "id",
        "callId",
        "name",
        "path"
      ]
    },
    {
      "type": "object",
      "properties": {
        "afterBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "afterSha256": {
          "type": "string"
        },
        "beforeBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "beforeSha256": {
          "type": "string"
        },
        "callId": {
          "type": "string"
        },
        "diff": {
          "type": "string"
        },
        "finalNewline": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FileChangeKind"
        },
        "newlineStyle": {
          "$ref": "#/$defs/FileChangeNewlineStyle"
        },
        "path": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "fileChange"
        }
      },
      "required": [
        "type",
        "id",
        "callId",
        "path",
        "kind",
        "diff",
        "beforeSha256",
        "afterSha256",
        "beforeBytes",
        "afterBytes",
        "newlineStyle",
        "finalNewline"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "callId": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "environmentPolicy": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "networkPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandNetworkPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "sandboxPolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandSandboxPolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "sandboxed": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "commandApprovalRequest"
        },
        "workspaceWritePolicy": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandWorkspaceWritePolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceWriteRisk": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandWorkspaceWriteRisk"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "approvalId",
        "callId",
        "command",
        "arguments",
        "cwd",
        "environmentPolicy",
        "sandboxed"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "commandApprovalDecision"
        },
        "workspaceWriteRiskAcknowledgement": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandWorkspaceWriteRisk"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "id",
        "approvalId",
        "decision"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "callId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "commandExecutionAttempt"
        }
      },
      "required": [
        "type",
        "id",
        "approvalId",
        "callId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "arguments": true,
        "argumentsBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "argumentsSha256": {
          "type": "string"
        },
        "callId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "inventorySha256": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "mcpToolCall"
        }
      },
      "required": [
        "type",
        "id",
        "callId",
        "name",
        "arguments",
        "argumentsBytes",
        "argumentsSha256",
        "inventorySha256"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "arguments": true,
        "argumentsBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "argumentsSha256": {
          "type": "string"
        },
        "callId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "inventorySha256": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "mcpToolCallApprovalRequest"
        }
      },
      "required": [
        "type",
        "id",
        "approvalId",
        "callId",
        "name",
        "arguments",
        "argumentsBytes",
        "argumentsSha256",
        "inventorySha256"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "mcpToolCallApprovalDecision"
        }
      },
      "required": [
        "type",
        "id",
        "approvalId",
        "decision"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string"
        },
        "callId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "inventorySha256": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "mcpToolExecutionAttempt"
        }
      },
      "required": [
        "type",
        "id",
        "approvalId",
        "callId",
        "inventorySha256"
      ]
    },
    {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/McpToolResult"
        },
        "type": {
          "type": "string",
          "const": "mcpToolResult"
        }
      },
      "required": [
        "type",
        "id",
        "callId",
        "name",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/ToolResult"
        },
        "type": {
          "type": "string",
          "const": "toolResult"
        }
      },
      "required": [
        "type",
        "id",
        "callId",
        "name",
        "result"
      ]
