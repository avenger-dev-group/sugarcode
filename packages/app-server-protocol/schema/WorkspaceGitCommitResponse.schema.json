{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceGitCommitResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "newHead": {
          "type": "string"
        },
        "oldHead": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "committed"
        }
      },
      "required": [
        "status",
        "revision",
        "oldHead",
        "newHead"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/WorkspaceGitErrorKind"
        },
        "status": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "status",
        "kind"
      ]
    }
  ],
  "$defs": {
    "WorkspaceGitErrorKind": {
      "type": "string",
      "enum": [
        "notRepository",
        "unsupportedRepository",
        "invalidPath",
        "stale",
        "nothingToCommit",
        "tooLarge",
        "unsupportedPath",
        "unborn",
        "detached",
        "repositoryState",
        "indexLocked",
        "changed",
        "unavailable"
      ]
    }
  }
}
