{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpToolCallApprovalParams",
  "type": "object",
  "properties": {
    "approvalId": {
      "type": "string"
    },
    "arguments": true,
    "argumentsBytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "argumentsSha256": {
      "type": "string"
    },
    "callId": {
      "type": "string"
    },
    "inventorySha256": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "sourceAgent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalSourceAgent"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "approvalId",
    "threadId",
    "turnId",
    "callId",
    "name",
    "arguments",
    "argumentsBytes",
    "argumentsSha256",
    "inventorySha256"
  ],
  "$defs": {
    "AgentTaskRole": {
      "type": "string",
      "enum": [
        "explorer",
        "worker",
        "auditor"
      ]
    },
    "ApprovalSourceAgent": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/AgentTaskRole"
        },
        "taskId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "taskId",
        "role"
      ]
    }
  }
}
