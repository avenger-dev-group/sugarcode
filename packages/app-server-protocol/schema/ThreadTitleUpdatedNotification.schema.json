{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadTitleUpdatedNotification",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "title": {
      "type": "string",
      "maxLength": 48,
      "minLength": 1
    },
    "workspaceId": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "threadId",
    "title"
  ]
}
