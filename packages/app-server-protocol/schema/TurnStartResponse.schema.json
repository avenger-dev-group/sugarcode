{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnStartResponse",
  "type": "object",
  "properties": {
    "turn": {
      "$ref": "#/$defs/Turn"
    }
  },
  "required": [
    "turn"
  ],
  "$defs": {
    "ModelProviderFamily": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "gemini"
      ]
    },
    "ModelSelectionCapabilities": {
      "type": "object",
      "properties": {
        "imageInput": {
          "type": "boolean"
        },
        "parallelTools": {
          "type": "boolean"
        },
        "pdfInput": {
          "type": "boolean"
        },
        "strictTools": {
          "type": "boolean"
        },
        "toolCalls": {
          "type": "boolean"
        }
      },
      "required": [
        "toolCalls",
        "strictTools",
        "parallelTools",
        "imageInput",
        "pdfInput"
      ]
    },
    "ModelSelectionSnapshot": {
      "type": "object",
      "properties": {
        "contextWindowTokens": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "displayName": {
          "type": "string"
        },
        "effectiveCapabilities": {
          "$ref": "#/$defs/ModelSelectionCapabilities"
        },
        "modelId": {
          "type": "string"
        },
        "profileId": {
          "type": "string"
        },
        "providerFamily": {
          "$ref": "#/$defs/ModelProviderFamily"
        },
        "wireApi": {
          "$ref": "#/$defs/ModelWireApi"
        }
      },
      "required": [
        "profileId",
        "providerFamily",
        "wireApi",
        "modelId",
        "displayName",
        "contextWindowTokens",
        "effectiveCapabilities"
      ]
    },
    "ModelWireApi": {
      "type": "string",
      "enum": [
        "openaiResponses",
        "openaiChatCompletions",
        "anthropicMessages",
        "geminiGenerateContent"
      ]
    },
    "ProviderErrorMetadata": {
      "type": "object",
      "properties": {
        "code": {
          "type": [
            "string",
            "null"
          ]
        },
        "httpStatus": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "retryAfter": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "httpStatus"
      ]
    },
    "ToolSchemaError": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "toolName": {
          "type": "string"
        }
      },
      "required": [
        "toolName",
        "reason"
      ]
    },
    "Turn": {
      "type": "object",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSelectionSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/TurnStatus"
        }
      },
      "required": [
        "id",
        "status"
      ]
    },
    "TurnError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TurnErrorKind"
        },
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderErrorMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "toolSchema": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolSchemaError"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "retryable"
      ]
    },
    "TurnErrorKind": {
      "type": "string",
      "enum": [
        "authentication",
        "invalidRequest",
        "rateLimited",
        "timeout",
        "transport",
        "disconnected",
        "server",
        "protocol",
        "incomplete",
        "filtered",
        "unsupportedOutput",
        "unsupportedToolArguments",
        "outputTooLarge",
        "stateUnavailable"
      ]
    },
    "TurnStatus": {
      "type": "string",
      "enum": [
        "inProgress",
        "completed",
        "failed",
        "interrupted"
      ]
    }
  }
}
