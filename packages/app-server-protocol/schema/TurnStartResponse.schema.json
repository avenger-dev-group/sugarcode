{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnStartResponse",
  "type": "object",
  "properties": {
    "turn": {
      "$ref": "#/$defs/Turn"
    }
  },
  "required": [
    "turn"
  ],
  "$defs": {
    "Turn": {
      "type": "object",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/TurnError"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TurnStatus"
        }
      },
      "required": [
        "id",
        "status"
      ]
    },
    "TurnError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/TurnErrorKind"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "retryable"
      ]
    },
    "TurnErrorKind": {
      "type": "string",
      "enum": [
        "authentication",
        "invalidRequest",
        "rateLimited",
        "timeout",
        "transport",
        "server",
        "protocol",
        "incomplete",
        "filtered",
        "unsupportedOutput",
        "outputTooLarge",
        "stateUnavailable"
      ]
    },
    "TurnStatus": {
      "type": "string",
      "enum": [
        "inProgress",
        "completed",
        "failed",
        "interrupted"
      ]
    }
  }
}
