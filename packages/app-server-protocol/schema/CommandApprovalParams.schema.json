{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandApprovalParams",
  "type": "object",
  "properties": {
    "approvalId": {
      "type": "string"
    },
    "approvalScope": {
      "type": "string"
    },
    "arguments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "callId": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "environmentPolicy": {
      "type": "string"
    },
    "networkPolicy": {
      "$ref": "#/$defs/CommandNetworkPolicy"
    },
    "sandboxPolicy": {
      "$ref": "#/$defs/CommandSandboxPolicy"
    },
    "sandboxed": {
      "type": "boolean"
    },
    "sourceAgent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApprovalSourceAgent"
        },
        {
          "type": "null"
        }
      ]
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "workspaceWritePolicy": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommandWorkspaceWritePolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaceWriteRisk": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommandWorkspaceWriteRisk"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "approvalId",
    "threadId",
    "turnId",
    "callId",
    "command",
    "arguments",
    "cwd",
    "approvalScope",
    "environmentPolicy",
    "sandboxed",
    "sandboxPolicy",
    "networkPolicy"
  ],
  "$defs": {
    "AgentTaskRole": {
      "type": "string",
      "enum": [
        "explorer",
        "worker",
        "auditor"
      ]
    },
    "ApprovalSourceAgent": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/AgentTaskRole"
        },
        "taskId": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "taskId",
        "role"
      ]
    },
    "CommandNetworkPolicy": {
      "type": "string",
      "enum": [
        "networkDeniedV1"
      ]
    },
    "CommandSandboxPolicy": {
      "type": "string",
      "enum": [
        "filesystemReadOnlyV1"
      ]
    },
    "CommandWorkspaceWritePolicy": {
      "type": "string",
      "enum": [
        "commandWorkspaceWriteV1"
      ]
    },
    "CommandWorkspaceWriteRisk": {
      "type": "string",
      "enum": [
        "nonTransactionalWorkspaceTreeV1"
      ]
    }
  }
}
