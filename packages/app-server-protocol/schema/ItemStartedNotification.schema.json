{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ItemStartedNotification",
  "type": "object",
  "properties": {
    "item": {
      "$ref": "#/$defs/Item"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "turnId",
    "item"
  ],
  "$defs": {
    "Item": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "userMessage"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "agentMessage"
            }
          },
          "required": [
            "type",
            "id",
            "text"
          ]
        }
      ]
    }
  }
}
