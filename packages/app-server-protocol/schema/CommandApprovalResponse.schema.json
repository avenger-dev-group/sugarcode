{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandApprovalResponse",
  "type": "object",
  "properties": {
    "decision": {
      "$ref": "#/$defs/CommandApprovalResponseDecision"
    },
    "workspaceWriteRiskAcknowledgement": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommandWorkspaceWriteRisk"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "decision"
  ],
  "$defs": {
    "CommandApprovalResponseDecision": {
      "type": "string",
      "enum": [
        "approved",
        "denied"
      ]
    },
    "CommandWorkspaceWriteRisk": {
      "type": "string",
      "enum": [
        "nonTransactionalWorkspaceTreeV1"
      ]
    }
  }
}
