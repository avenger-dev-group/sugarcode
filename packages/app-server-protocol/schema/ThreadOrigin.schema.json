{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadOrigin",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "orchestrationId": {
          "type": "string"
        },
        "parentThreadId": {
          "type": "string"
        },
        "parentTurnId": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/AgentTaskRole"
        },
        "taskId": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "subagent"
        }
      },
      "required": [
        "type",
        "parentThreadId",
        "parentTurnId",
        "orchestrationId",
        "taskId",
        "role"
      ]
    }
  ],
  "$defs": {
    "AgentTaskRole": {
      "type": "string",
      "enum": [
        "explorer",
        "worker",
        "auditor"
      ]
    }
  }
}
