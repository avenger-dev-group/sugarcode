{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelSelectionSnapshot",
  "type": "object",
  "properties": {
    "contextWindowTokens": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "displayName": {
      "type": "string"
    },
    "effectiveCapabilities": {
      "$ref": "#/$defs/ModelSelectionCapabilities"
    },
    "modelId": {
      "type": "string"
    },
    "profileId": {
      "type": "string"
    },
    "providerFamily": {
      "$ref": "#/$defs/ModelProviderFamily"
    },
    "wireApi": {
      "$ref": "#/$defs/ModelWireApi"
    }
  },
  "required": [
    "profileId",
    "providerFamily",
    "wireApi",
    "modelId",
    "displayName",
    "contextWindowTokens",
    "effectiveCapabilities"
  ],
  "$defs": {
    "ModelProviderFamily": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "gemini"
      ]
    },
    "ModelSelectionCapabilities": {
      "type": "object",
      "properties": {
        "imageInput": {
          "type": "boolean"
        },
        "parallelTools": {
          "type": "boolean"
        },
        "pdfInput": {
          "type": "boolean"
        },
        "strictTools": {
          "type": "boolean"
        },
        "toolCalls": {
          "type": "boolean"
        }
      },
      "required": [
        "toolCalls",
        "strictTools",
        "parallelTools",
        "imageInput",
        "pdfInput"
      ]
    },
    "ModelWireApi": {
      "type": "string",
      "enum": [
        "openaiResponses",
        "openaiChatCompletions",
        "anthropicMessages",
        "geminiGenerateContent"
      ]
    }
  }
}
