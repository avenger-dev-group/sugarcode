{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ModelSelectionSnapshot",
  "type": "object",
  "properties": {
    "contextWindowTokens": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "displayName": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "profileId": {
      "type": "string"
    },
    "providerKind": {
      "$ref": "#/$defs/ModelProviderKind"
    }
  },
  "required": [
    "profileId",
    "providerKind",
    "modelId",
    "displayName",
    "contextWindowTokens"
  ],
  "$defs": {
    "ModelProviderKind": {
      "type": "string",
      "enum": [
        "openai",
        "anthropic",
        "gemini",
        "metallm",
        "openaiCompatible"
      ]
    }
  }
}
