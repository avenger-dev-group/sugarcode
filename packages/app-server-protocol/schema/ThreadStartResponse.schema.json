{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadStartResponse",
  "type": "object",
  "properties": {
    "thread": {
      "$ref": "#/$defs/Thread"
    }
  },
  "required": [
    "thread"
  ],
  "$defs": {
    "AgentTaskRole": {
      "type": "string",
      "enum": [
        "explorer",
        "worker",
        "auditor"
      ]
    },
    "Thread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThreadOrigin"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "minLength": 1
        },
        "workspaceId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspaceId"
      ]
    },
    "ThreadOrigin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "orchestrationId": {
              "type": "string"
            },
            "parentThreadId": {
              "type": "string"
            },
            "parentTurnId": {
              "type": "string"
            },
            "role": {
              "$ref": "#/$defs/AgentTaskRole"
            },
            "taskId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "subagent"
            }
          },
          "required": [
            "type",
            "parentThreadId",
            "parentTurnId",
            "orchestrationId",
            "taskId",
            "role"
          ]
        }
      ]
    }
  }
}
