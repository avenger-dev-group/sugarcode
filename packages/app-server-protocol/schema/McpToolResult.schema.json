{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpToolResult",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "canonical_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "content": {
          "type": "string"
        },
        "content_blocks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "is_error": {
          "type": "boolean"
        },
        "observed_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "retained_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "structured_content": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "const": "completed"
        }
      },
      "required": [
        "type",
        "content",
        "is_error",
        "observed_bytes",
        "canonical_bytes",
        "retained_bytes",
        "truncated",
        "sha256",
        "content_blocks",
        "structured_content"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "request_state": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "error"
        }
      },
      "required": [
        "type",
        "kind",
        "request_state"
      ]
    }
  ]
}
