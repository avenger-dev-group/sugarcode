{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TurnStartParams",
  "type": "object",
  "properties": {
    "input": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/TurnInputPart"
      }
    },
    "modelProfileId": {
      "type": [
        "string",
        "null"
      ]
    },
    "threadId": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "threadId"
  ],
  "$defs": {
    "AssetDescriptor": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "mediaType": {
          "type": "string"
        },
        "originalName": {
          "type": "string"
        },
        "pdfPages": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "sha256": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "assetId",
        "sha256",
        "mediaType",
        "originalName",
        "sizeBytes",
        "kind"
      ]
    },
    "AssetKind": {
      "type": "string",
      "enum": [
        "image",
        "pdf",
        "text"
      ]
    },
    "TurnInputPart": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "asset": {
              "$ref": "#/$defs/AssetDescriptor"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "asset"
          ]
        },
        {
          "type": "object",
          "properties": {
            "asset": {
              "$ref": "#/$defs/AssetDescriptor"
            },
            "type": {
              "type": "string",
              "const": "document"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "asset"
          ]
        }
      ]
    }
  }
}
