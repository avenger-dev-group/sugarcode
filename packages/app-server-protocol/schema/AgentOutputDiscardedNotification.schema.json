{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentOutputDiscardedNotification",
  "type": "object",
  "properties": {
    "output": {
      "$ref": "#/$defs/AgentOutputRef"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "threadId",
    "turnId",
    "output"
  ],
  "$defs": {
    "AgentOutputRef": {
      "type": "object",
      "properties": {
        "outputIndex": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "responseOrdinal": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "responseOrdinal",
        "outputIndex"
      ]
    }
  }
}
