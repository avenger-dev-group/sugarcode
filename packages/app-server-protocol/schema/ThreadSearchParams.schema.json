{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadSearchParams",
  "type": "object",
  "properties": {
    "cursor": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^thr_(?:[0-9]{16}|[1-9][0-9]{16,19})$"
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "maximum": 100,
      "minimum": 1
    },
    "query": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "query"
  ]
}
