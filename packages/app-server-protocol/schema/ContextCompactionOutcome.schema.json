{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContextCompactionOutcome",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "postContextBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "summaryBytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "summarySha256": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "completed"
        }
      },
      "required": [
        "type",
        "postContextBytes",
        "summaryBytes",
        "summarySha256"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "const": "failed"
        }
      },
      "required": [
        "type",
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "interrupted"
        }
      },
      "required": [
        "type"
      ]
    }
  ]
}
