{
  "name": "sugarcode",
  "version": "3.9.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron-winstaller",
      "fs-xattr",
      "macos-alias"
    ]
  },
  "scripts": {
    "build:native:dev": "node scripts/build-desktop-native.mjs",
    "build:native:release": "node scripts/build-desktop-native.mjs --release",
    "dev": "pnpm --filter @sugarcode/desktop start",
    "desktop:start": "pnpm --filter @sugarcode/desktop start",
    "desktop:package": "pnpm --filter @sugarcode/desktop package",
    "desktop:make": "pnpm --filter @sugarcode/desktop make",
    "desktop:publish": "pnpm --filter @sugarcode/desktop publish",
    "release:update-manifest": "node scripts/create-update-manifest.mjs",
    "release:gitcode": "node scripts/publish-gitcode-release.mjs",
    "release:gitcode:local": "node scripts/publish-gitcode-from-github.mjs",
    "lint": "pnpm --filter @sugarcode/desktop lint",
    "typecheck": "pnpm --filter @sugarcode/desktop typecheck",
    "test:scripts": "node --test \"scripts/tests/**/*.test.mjs\"",
    "test:performance": "cargo test -p sugarcode-desktop-native benchmark_ --locked -- --ignored --nocapture && cargo test -p sugarcode-desktop-native int8_vector_storage_evaluation_preserves_cosine_scores --locked -- --nocapture",
    "test:semantic-models:live": "cargo test -p sugarcode-desktop-native live_catalog_models_download_load_and_remove --locked -- --ignored --nocapture",
    "test:e2e": "pnpm build:native:dev && node scripts/run-desktop-e2e.mjs",
    "check:rust": "cargo metadata --locked --no-deps --format-version 1",
    "check": "pnpm --filter @sugarcode/desktop check && pnpm test:scripts && pnpm check:rust"
  },
  "devDependencies": {
    "node-gyp": "13.0.1"
  }
}
