{
  "name": "sugarcode",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "dev": "pnpm --filter @sugarcode/desktop start",
    "desktop:start": "pnpm --filter @sugarcode/desktop start",
    "desktop:package": "pnpm --filter @sugarcode/desktop package",
    "desktop:make": "pnpm --filter @sugarcode/desktop make",
    "desktop:publish": "pnpm --filter @sugarcode/desktop publish",
    "lint": "pnpm --filter @sugarcode/desktop lint",
    "typecheck": "pnpm --filter @sugarcode/desktop typecheck && pnpm --filter @sugarcode/app-server-protocol typecheck",
    "check:rust": "cargo metadata --no-deps --format-version 1 > /dev/null",
    "check": "pnpm --filter @sugarcode/desktop check && pnpm --filter @sugarcode/app-server-protocol check && pnpm check:rust"
  }
}
