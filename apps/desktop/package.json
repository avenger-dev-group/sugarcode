{
  "name": "@sugarcode/desktop",
  "productName": "SugarCode",
  "version": "1.0.0",
  "description": "SugarCode",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "pnpm --dir ../.. build:cli:dev && electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run src/main/app-server/tests/app-server-handshake.integration.test.ts src/main/app-server/tests/conversation-turn.integration.test.ts",
    "build:electron-test": "vite build --config vite.electron-test-main.config.ts && vite build --config vite.electron-test-preload.config.ts && vite build --config vite.electron-test-renderer.config.ts",
    "test:electron": "pnpm build:electron-test && electron .electron-test/main.cjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit"
  },
  "keywords": [],
  "author": {
    "name": "Simon",
    "email": "simoonf@vip.qq.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "43.2.0",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "@sugarcode/app-server-protocol": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^1.26.0",
    "radix-ui": "^1.6.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  }
}
